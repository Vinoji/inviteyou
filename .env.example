# Copy to .env (never commit .env). Values here are placeholders.

# Public site URL — links sent to owners, share previews (OG), sitemap.
# Production: https://inviteforyou.in (the default when unset — lib/site.ts).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase web app (public by design; access is enforced by the rules files).
# Optional: lib/firebase.ts falls back to the production project if unset.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin — the service-account JSON on ONE line (server only, secret).
FIREBASE_ADMIN_KEY={"type":"service_account","project_id":"your-project",...}

# Razorpay (server secret + public key id).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Secret typed into Razorpay Dashboard → Webhooks for /api/razorpay-webhook.
RAZORPAY_WEBHOOK_SECRET=
