rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Photos and an optional background-music track live under
    // invitations/{draftId}/*. The draftId is a random UUID generated
    // client-side, so the path itself isn't guessable. There's no auth
    // system in this app, so — like the rest of the product — access
    // control here relies on the id being unguessable plus basic
    // content-type/size validation rather than an owner check.
    match /invitations/{invitationId}/{fileName} {
      allow read: if true;
      allow write: if (request.resource.contentType.matches('image/.*')
                        && request.resource.size < 8 * 1024 * 1024)
                   || (request.resource.contentType.matches('audio/.*')
                        && request.resource.size < 15 * 1024 * 1024);
      allow delete: if false;
    }

    // Guest-submitted photos, uploaded straight from the public invite
    // page. Unlike the path above, this folder is reachable by anyone with
    // the (intentionally public) invite link — that's the point, guests
    // are meant to add photos here. The per-invitation photo count cap and
    // rate limiting live in the Admin SDK route that registers each
    // upload in Firestore (POST /api/guest-photos/[slug]), not here —
    // Storage rules alone can't count existing files or rate-limit.
    match /invitations/{invitationId}/guest-photos/{fileName} {
      allow read: if true;
      allow write: if request.resource.contentType.matches('image/.*')
                   && request.resource.size < 8 * 1024 * 1024;
      allow delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
