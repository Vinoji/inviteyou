rules_version = '2';

// Every read and write in this app goes through the Admin SDK in server
// route handlers and server components, which bypass these rules. No
// browser code reads Firestore directly, so clients get no access at all:
// published invitations are served as rendered pages, and guest names,
// RSVP messages, phone numbers and edit tokens are never listable through
// the public Firestore API.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
